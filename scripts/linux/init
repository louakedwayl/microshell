#!/bin/sh
# PID 1 inside the local guest. No network relay or external service is used.
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /run /workspace
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
hostname minishell
export HOME=/root USER=root LOGNAME=root TERM=xterm-256color LANG=en_US.UTF-8
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
cd /workspace
while true; do
    /bin/busybox setsid /bin/busybox cttyhack /bin/zsh -l
    printf '\r\nSession terminée. Redémarrage du shell…\r\n'
done
